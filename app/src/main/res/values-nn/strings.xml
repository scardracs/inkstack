	<string name="community_intro_title">Kommentarer og vurderinger</string>
	<string name="community_intro_body">Inkstack kan no vise kommentarer og vurderinger frå andre lesere, og bruke det alle lærer for å sette kjelder som faktisk fungerer øverst i søkene dine.\n\nIngen konto. Ingen e-post, ingen passord. Eininga din lager ein tilfeldig nøkkel, og det er hele identiteten din — du kan sikkerhetskopiere og flytte den til ein ny telefon.</string>
	<string name="community_recover">Gjenopprett</string>
	<string name="community_recover_title">Gjenopprett kontoen din</string>
	<string name="community_recover_body">Lim inn gjenopprettingsnøkkelen frå den andre eininga. Du finner den under Innstillinger, Tjenester, Fellesskap.

Kommentarer, vurderinger og kallenavn kommer tilbake med den.</string>
	<string name="community_recover_hint">Gjenopprettingsnøkkel</string>
	<string name="community_recover_action">Gjenopprett</string>
	<string name="community_recover_malformed">Det er ikkje ein gjenopprettingsnøkkel. Den er 43 tegn uten mellomrom.</string>
	<string name="community_recover_unknown">Ingen konto på denne tenaren brukar den nøkkelen. Sjekk manglende eller feil tegn — en skrivefeil er ein annen nøkkel, ikkje ein ødelagt.</string>
	<string name="community_recover_failed">Kunne ikkje no tenaren. Prøv att om eit øyeblikk.</string>
